[sub_resource type="GDScript" id="GDScript_28bik"]
script/source = "extends Node2D

@export var boss_scene: PackedScene

@onready var player_area: Area2D = $PlayerArea 
@onready var player = get_tree().get_first_node_in_group(\"player\")

@onready var spawn_areas: Array[Area2D] = [
	$Area2D_1,
	$Area2D_2,
	$Area2D_3,
	$Area2D_4
]

var is_player_near: bool = false
var is_boss_spawned: bool = false
var can_spawn_boss: bool = true

var occupied_areas: Dictionary = {}

func _ready() -> void:
	for area in spawn_areas:
		occupied_areas[area] = null
		area.body_entered.connect(_on_spawn_area_body_entered.bind(area))
		
	_scan_overlapping_enemies()

func _on_spawn_area_body_entered(body: Node2D, area: Area2D) -> void:
	_process_enemy_entry(body, area)

func _process_enemy_entry(body: Node2D, area: Area2D) -> void:
	var is_area_empty = occupied_areas[area] == null or not is_instance_valid(occupied_areas[area])
	var is_enemy = body.is_in_group(\"Enemies\") or body.is_in_group(\"enemies\")
	
	if is_enemy and is_area_empty:
		occupied_areas[area] = body
		body.global_position = area.global_position
		
		body.set_process(false)
		body.set_physics_process(false)
		
		if body.has_node(\"CollisionShape2D\"):
			body.get_node(\"CollisionShape2D\").set_deferred(\"disabled\", true)
			
		check_requirements()

func _scan_overlapping_enemies() -> void:
	for area in spawn_areas:
		for body in area.get_overlapping_bodies():
			_process_enemy_entry(body, area)

func _all_areas_occupied() -> bool:
	var count = 0
	for area in spawn_areas:
		if occupied_areas[area] != null and is_instance_valid(occupied_areas[area]):
			count += 1
	return count == spawn_areas.size()

func check_requirements() -> void:
	if _all_areas_occupied() and can_spawn_boss and not is_boss_spawned:
		if not boss_scene:
			return
		spawn_boss.call_deferred()

func spawn_boss() -> void:
	is_boss_spawned = true
	can_spawn_boss = false
	
	for area in spawn_areas:
		var enemy = occupied_areas[area]
		if is_instance_valid(enemy):
			enemy.queue_free()
		occupied_areas[area] = null
	
	var boss = boss_scene.instantiate()
	boss.global_position = global_position
	boss.scale = Vector2.ZERO
	
	get_parent().add_child(boss)
	
	
	boss.tree_exited.connect(_on_boss_died)
	
	var health_bar = get_tree().current_scene.find_child(\"SlimeBossHealthBar\", true, false)
	if health_bar:
		health_bar.show()
		health_bar.setup_boss(boss)

	var tween = create_tween()
	tween.tween_property(boss, \"scale\", Vector2(2.5, 2.5), 0.7).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)

func _on_boss_died() -> void:
	is_boss_spawned = false
	
	var health_bar = get_tree().current_scene.find_child(\"SlimeBossHealthBar\", true, false)
	if health_bar:
		health_bar.hide()
		
	await get_tree().create_timer(300.0).timeout
	can_spawn_boss = true
	check_requirements()

func _on_player_area_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		player = body
		is_player_near = true

func _on_player_area_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"player\"):
		is_player_near = false
"

